@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="0" Class="sg-appbar">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="DrawerToggle" />
        <div class="brand-lockup">
            <span class="brand-mark">SG</span>
            <div>
                <MudText Typo="Typo.subtitle1" Class="brand-title">Smart Grow</MudText>
                <MudText Typo="Typo.caption" Class="brand-caption">IoT DIGITAL TWIN</MudText>
            </div>
        </div>
        <MudSpacer />
        <span class="top-status"><i></i> Gateway ready</span>
        <MudIconButton Icon="@DarkLightModeButtonIcon" Color="Color.Inherit" OnClick="DarkModeToggle" />
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="0" Class="sg-drawer">
        <NavMenu />
        <div class="drawer-foot"><span>EDGE CONSOLE</span><strong>v2.0</strong></div>
    </MudDrawer>

    <MudMainContent Class="sg-main">@Body</MudMainContent>
</MudLayout>

<div id="blazor-error-ui">
    화면을 갱신하는 중 문제가 발생했습니다.
    <a href="" class="reload">다시 불러오기</a>
    <a class="dismiss">×</a>
</div>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = true;
    private MudTheme _theme = new();

    protected override void OnInitialized()
    {
        _theme = new MudTheme
        {
            PaletteLight = new PaletteLight
            {
                Primary = "#0A7C66", Secondary = "#605DEC", Tertiary = "#D97706",
                Background = "#F4F7F6", Surface = "#FFFFFF", AppbarBackground = "rgba(255,255,255,.86)",
                AppbarText = "#13231F", DrawerBackground = "#FFFFFF", DrawerText = "#42534E",
                TextPrimary = "#13231F", TextSecondary = "#65756F", Success = "#0A7C66"
            },
            PaletteDark = new PaletteDark
            {
                Primary = "#62D6B8", Secondary = "#A5A3FF", Tertiary = "#F5B862",
                Background = "#0B1210", Surface = "#121C19", AppbarBackground = "rgba(11,18,16,.88)",
                AppbarText = "#ECF8F4", DrawerBackground = "#0E1714", DrawerText = "#B6C9C2",
                TextPrimary = "#ECF8F4", TextSecondary = "#92A8A0", Success = "#62D6B8",
                Info = "#70A7FF", Warning = "#F5B862", Error = "#FF7C86"
            },
            LayoutProperties = new LayoutProperties { DefaultBorderRadius = "14px" }
        };
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;
    private void DarkModeToggle() => _isDarkMode = !_isDarkMode;
    private string DarkLightModeButtonIcon => _isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode;
}
