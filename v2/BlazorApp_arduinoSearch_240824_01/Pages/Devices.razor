@page "/devices"
@implements IDisposable
@inject DeviceDiscoveryService DeviceDiscoveryService
@inject IHttpClientFactory HttpClientFactory
@inject MqttService MqttService
@inject NavigationManager NavigationManager
@using System.Globalization
@using System.Net
@using System.Net.Sockets
@using System.Text
@using System.Text.Json

<PageTitle>Devices - Embedded IoT</PageTitle>

<div class="container mt-4">
    <h3 class="mb-4">
        <span class="oi oi-list-rich me-2" aria-hidden="true"></span>
        연결된 장치
    </h3>

    @if (!string.IsNullOrWhiteSpace(mqttStatus))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @mqttStatus
            <button type="button" class="btn-close" @onclick="() => mqttStatus = string.Empty"></button>
        </div>
    }

    @if (isLoading)
    {
        <div class="card mb-4">
            <div class="card-body">
                <div class="mb-3">
                    <p class="mb-2">
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        장치 검색 중... @discoveryProgress.Message
                    </p>
                    <progress class="w-100" max="@ProgressMax" value="@discoveryProgress.Scanned"></progress>
                </div>
                @if (!string.IsNullOrWhiteSpace(discoveryProgress.CurrentIpAddress))
                {
                    <p class="small text-muted mb-0">
                        현재 IP: @discoveryProgress.CurrentIpAddress / 발견됨: @discoveryProgress.Found
                    </p>
                }
            </div>
        </div>
    }
    else if (devices.Any())
    {
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>장치명</th>
                        <th>IP 주소</th>
                        <th>설명</th>
                        <th>MQTT 서버</th>
                        <th>MQTT 포트</th>
                        <th>MQTT 토픽</th>
                        <th>작업</th>
                    </tr>
                </thead>
                <tbody>
            @foreach (var device in devices)
            {
                var deviceKey = GetDeviceKey(device);
                <tr>
                    <td>@DisplayValue(device.Name, "Unknown")</td>
                    <td>@device.Address</td>
                    <td>@DisplayValue(device.Description, "-")</td>
                    <td>
                        @if (!device.HasError)
                        {
                            <input class="form-control form-control-sm" type="text" placeholder="MQTT server" @bind="@device.MqttServer" />
                        }
                    </td>
                    <td>
                        @if (!device.HasError)
                        {
                            <input class="form-control form-control-sm" type="number" min="1" max="65535" placeholder="1883" @bind="@device.MqttPort" />
                        }
                    </td>
                    <td>
                        @if (!device.HasError)
                        {
                            <input class="form-control form-control-sm" type="text" placeholder="MQTT topic" @bind="@device.MqttTopic" />
                        }
                    </td>
                    <td>
                        @if (!device.HasError)
                        {
                            var isConfiguring = configuringDevices.Contains(deviceKey);
                            <button class="btn btn-primary btn-sm" disabled="@isConfiguring" @onclick="() => ConnectToDevice(device)">
                                @if (isConfiguring)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Configuring...</span>
                                }
                                else
                                {
                                    <span>Connect</span>
                                }
                            </button>
                            @if (connectionErrors.TryGetValue(deviceKey, out var error))
                            {
                                <div class="text-danger small mt-1">@error</div>
                            }
                        }
                        else
                        {
                            <button class="btn btn-danger btn-sm" disabled>Error</button>
                        }
                    </td>
                </tr>
            }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning" role="alert">
            <span class="oi oi-info me-2" aria-hidden="true"></span>
            발견된 장치가 없습니다.
        </div>
    }
</div>

@code {
    private readonly Dictionary<string, string> connectionErrors = new();
    private readonly HashSet<string> configuringDevices = new();
    private List<Device> devices = new();
    private DeviceDiscoveryProgress discoveryProgress = new();
    private bool isLoading = true;
    private string mqttStatus = string.Empty;
    private bool disposed;

    private int ProgressMax => Math.Max(1, discoveryProgress.Total);

    protected override async Task OnInitializedAsync()
    {
        var progress = new Progress<DeviceDiscoveryProgress>(value =>
        {
            discoveryProgress = value;

            if (!disposed)
            {
                _ = InvokeAsync(StateHasChanged);
            }
        });

        try
        {
            devices = await DeviceDiscoveryService.DiscoverDevicesAsync(progress);
            ApplyMqttDefaults(devices);
        }
        catch (Exception ex)
        {
            mqttStatus = $"Device discovery failed: {ex.Message}";
        }
        finally
        {
            isLoading = false;

            if (!disposed)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task ConnectToDevice(Device device)
    {
        var deviceKey = GetDeviceKey(device);
        connectionErrors.Remove(deviceKey);
        mqttStatus = string.Empty;

        if (!TryValidateMqtt(device, out var mqttPort))
        {
            return;
        }

        configuringDevices.Add(deviceKey);
        await InvokeAsync(StateHasChanged);

        try
        {
            device.MqttServer = device.MqttServer.Trim();
            device.MqttPort = mqttPort.ToString(CultureInfo.InvariantCulture);
            device.MqttTopic = device.MqttTopic.Trim();

            var connected = await MqttService.ConnectAsync(device.MqttServer, mqttPort, device.MqttTopic);
            mqttStatus = MqttService.LastStatus;

            if (!connected)
            {
                connectionErrors[deviceKey] = MqttService.LastError;
                return;
            }

            if (!await ConfigureMqttOnDevice(device, deviceKey))
            {
                return;
            }

            var route = ResolveDeviceRoute(device);

            if (string.IsNullOrWhiteSpace(route))
            {
                connectionErrors[deviceKey] = $"Unsupported device type: {DisplayValue(device.Name, "Unknown")}";
                return;
            }

            NavigationManager.NavigateTo(BuildDeviceUrl(route, device, mqttPort));
        }
        finally
        {
            configuringDevices.Remove(deviceKey);
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool TryValidateMqtt(Device device, out int mqttPort)
    {
        mqttPort = 0;
        var deviceKey = GetDeviceKey(device);

        if (string.IsNullOrWhiteSpace(device.MqttServer))
        {
            connectionErrors[deviceKey] = "MQTT server is required.";
            return false;
        }

        if (!int.TryParse(device.MqttPort, NumberStyles.Integer, CultureInfo.InvariantCulture, out mqttPort) ||
            mqttPort is < 1 or > 65535)
        {
            connectionErrors[deviceKey] = "MQTT port must be a number between 1 and 65535.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(device.MqttTopic))
        {
            connectionErrors[deviceKey] = "MQTT topic is required.";
            return false;
        }

        return true;
    }

    private async Task<bool> ConfigureMqttOnDevice(Device device, string deviceKey)
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient();
            var jsonData = new
            {
                mqtt_server = device.MqttServer,
                mqtt_port = device.MqttPort,
                mqtt_topic = device.MqttTopic
            };
            var jsonString = JsonSerializer.Serialize(jsonData);
            using var content = new StringContent(jsonString, Encoding.UTF8, "application/json");

            using var response = await httpClient.PostAsync($"http://{device.Address}/configure_mqtt", content);

            if (response.IsSuccessStatusCode)
            {
                return true;
            }

            connectionErrors[deviceKey] = $"MQTT configuration failed: HTTP {(int)response.StatusCode}";
            return false;
        }
        catch (Exception ex)
        {
            connectionErrors[deviceKey] = $"MQTT configuration failed: {ex.Message}";
            return false;
        }
    }

    private void ApplyMqttDefaults(IEnumerable<Device> discoveredDevices)
    {
        var defaultServer = GetLocalIPAddress();

        foreach (var device in discoveredDevices.Where(device => !device.HasError))
        {
            if (string.IsNullOrWhiteSpace(device.MqttServer))
            {
                device.MqttServer = defaultServer;
            }

            if (string.IsNullOrWhiteSpace(device.MqttPort))
            {
                device.MqttPort = "1883";
            }
        }
    }

    private static string BuildDeviceUrl(string route, Device device, int mqttPort)
    {
        return $"{route}?mqttAddress={Uri.EscapeDataString(device.MqttServer)}&mqttPort={mqttPort}&mqttTopic={Uri.EscapeDataString(device.MqttTopic)}";
    }

    private static string ResolveDeviceRoute(Device device)
    {
        var name = device.Name ?? string.Empty;

        if (name.Contains("LED", StringComparison.OrdinalIgnoreCase))
        {
            return "/ledControl";
        }

        if (name.Contains("DHZ", StringComparison.OrdinalIgnoreCase) ||
            name.Contains("DHT", StringComparison.OrdinalIgnoreCase))
        {
            return "/DHZChart";
        }

        if (name.Contains("Soil", StringComparison.OrdinalIgnoreCase))
        {
            return "/soilMoistureChart";
        }

        return string.Empty;
    }

    private static string GetDeviceKey(Device device)
    {
        return string.IsNullOrWhiteSpace(device.Address) ? DisplayValue(device.Name, "unknown") : device.Address;
    }

    private static string DisplayValue(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    private static string GetLocalIPAddress()
    {
        try
        {
            var host = Dns.GetHostName();
            var ip = Dns.GetHostAddresses(host)
                .FirstOrDefault(address => address.AddressFamily == AddressFamily.InterNetwork && !IPAddress.IsLoopback(address));

            return ip?.ToString() ?? "localhost";
        }
        catch
        {
            return "localhost";
        }
    }

    public void Dispose()
    {
        disposed = true;
    }
}

