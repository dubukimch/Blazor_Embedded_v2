@implements IDisposable
@inject MqttService MqttService
@inject IJSRuntime JSRuntime

<h3 class="modal-title">LED Control</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}

<div class="control-container">
    <div class="left-container">
        <p>
            <MatDatePicker @bind-Value="@Date1"></MatDatePicker>
        </p>
        <MatButton Class="now-button" OnClick="@(_ => Date1 = DateTime.Now)">Now</MatButton>
    </div>
    <div class="right-container">
        <MatButton
            OnClick="TurnOn"
            Disabled="@(isOn || !CanPublishLed)"
            Class="@($"button-base turn-on-button {OnButtonClass}")">
            On
        </MatButton>

        <MatButton
            OnClick="TurnOff"
            Disabled="@(isOff || !CanPublishLed)"
            Class="@($"button-base turn-off-button {OffButtonClass}")">
            Off
        </MatButton>
    </div>
</div>

<div class="chart-container">
    <canvas id="lightSensorChart"></canvas>
</div>

@code {
    private static readonly string[] SensorKeys = ["east", "west", "south", "north"];

    public DateTime? Date1 { get; set; } = DateTime.Now.AddDays(-10);

    [Parameter] public string MqttAddress { get; set; } = string.Empty;
    [Parameter] public string IpAddress { get; set; } = string.Empty;
    [Parameter] public int MqttPort { get; set; }
    [Parameter] public Dictionary<string, List<string>> MqttTopics { get; set; } = new();

    private readonly int[] morningData = new int[4];
    private readonly int[] afternoonData = new int[4];
    private readonly int[] eveningData = new int[4];

    private bool isOn;
    private bool isOff;
    private string OnButtonClass = string.Empty;
    private string OffButtonClass = string.Empty;
    private string errorMessage = string.Empty;

    private bool CanPublishLed => !string.IsNullOrWhiteSpace(GetFirstTopic("led"));

    public void OnDialogOpened()
    {
        _ = InvokeAsync(RenderChart);
    }

    protected override void OnInitialized()
    {
        MqttService.OnMessageReceived += HandleMqttMessage;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RenderChart();
        }
    }

    private async Task RenderChart()
    {
        await JSRuntime.InvokeVoidAsync("renderLightSensorChart", "lightSensorChart", GetLightSensorData());
    }

    private Task TurnOn()
    {
        return PublishLedCommand("ON");
    }

    private Task TurnOff()
    {
        return PublishLedCommand("OFF");
    }

    private async Task PublishLedCommand(string command)
    {
        var topic = GetFirstTopic("led");

        if (string.IsNullOrWhiteSpace(topic))
        {
            errorMessage = "LED MQTT topic is not configured.";
            return;
        }

        var published = await MqttService.PublishMessageAsync(topic, command);

        if (!published)
        {
            errorMessage = MqttService.LastError;
            return;
        }

        errorMessage = string.Empty;
        ApplyLedState(command);
    }

    private void HandleMqttMessage(string topic, string message)
    {
        var ledTopic = GetFirstTopic("led");

        if (!string.IsNullOrWhiteSpace(ledTopic) &&
            string.Equals(topic, ledTopic, StringComparison.OrdinalIgnoreCase))
        {
            ApplyLedState(message);
        }

        var sensorIndex = GetSensorIndex(topic);

        if (sensorIndex >= 0 &&
            int.TryParse(message, out var value))
        {
            UpdateLightSensorData(sensorIndex, value);
        }

        _ = InvokeAsync(StateHasChanged);
    }

    private void ApplyLedState(string message)
    {
        if (string.Equals(message, "ON", StringComparison.OrdinalIgnoreCase))
        {
            isOn = true;
            isOff = false;
            OnButtonClass = "disabled-button";
            OffButtonClass = string.Empty;
        }
        else if (string.Equals(message, "OFF", StringComparison.OrdinalIgnoreCase))
        {
            isOff = true;
            isOn = false;
            OffButtonClass = "disabled-button";
            OnButtonClass = string.Empty;
        }
    }

    private void UpdateLightSensorData(int sensorIndex, int value)
    {
        var currentTime = DateTime.Now;

        if (currentTime.Hour >= 6 && currentTime.Hour < 12)
        {
            morningData[sensorIndex] = value;
        }
        else if (currentTime.Hour >= 12 && currentTime.Hour < 18)
        {
            afternoonData[sensorIndex] = value;
        }
        else
        {
            eveningData[sensorIndex] = value;
        }

        _ = InvokeAsync(UpdateChart);
    }

    private async Task UpdateChart()
    {
        await JSRuntime.InvokeVoidAsync("updateLightSensorChart", "lightSensorChart", GetLightSensorData());
    }

    private object GetLightSensorData()
    {
        return new
        {
            morning = morningData,
            afternoon = afternoonData,
            evening = eveningData
        };
    }

    private string GetFirstTopic(string key)
    {
        return MqttTopics.TryGetValue(key, out var topics)
            ? topics.FirstOrDefault() ?? string.Empty
            : string.Empty;
    }

    private int GetSensorIndex(string topic)
    {
        for (var index = 0; index < SensorKeys.Length; index++)
        {
            if (MqttTopics.TryGetValue(SensorKeys[index], out var topics) &&
                topics.Any(sensorTopic => string.Equals(sensorTopic, topic, StringComparison.OrdinalIgnoreCase)))
            {
                return index;
            }
        }

        return -1;
    }

    public void Dispose()
    {
        MqttService.OnMessageReceived -= HandleMqttMessage;
    }
}
