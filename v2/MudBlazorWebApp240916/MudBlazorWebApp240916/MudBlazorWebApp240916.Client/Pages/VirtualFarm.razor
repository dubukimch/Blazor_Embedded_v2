@page "/VirtualFarm"
@implements IAsyncDisposable
@using System.Text.Json
@using Microsoft.JSInterop
@using MudBlazor.Components.Chart.Models
@using MudBlazorWebApp240916.Client.Services
@using MudBlazorWebApp240916.Shared.DataModel
@inject IJSRuntime JS
@inject IoTApiClient Api
@inject NavigationManager Navigation

<PageTitle>Smart Grow · Unity twin</PageTitle>

<main class="page-shell twin-page">
    <header class="page-heading">
        <div><span class="eyebrow">DIGITAL TWIN</span><h1>Unity WebGL bridge</h1><p>Unity 장면과 Blazor 차트가 동일한 MQTT 스트림을 구독합니다.</p></div>
        <div class="twin-actions"><div class="status-pill @(_unityReady ? "online" : "offline")"><i></i>@(_unityReady ? "Unity ready" : "Loading Unity")</div><MudIconButton Icon="@Icons.Material.Filled.Fullscreen" Color="Color.Primary" OnClick="SetFullscreenAsync" /></div>
    </header>

    <section class="twin-layout">
        <article class="unity-frame">
            <div class="unity-toolbar"><span><i></i> GREENHOUSE / LIVE SCENE</span><small>WebGL 2.0</small></div>
            <div id="unity-container" class="unity-host">
                <canvas id="unity-canvas" tabindex="0"></canvas>
                <div id="unity-loading-bar" class="unity-loading">
                    <strong>Loading digital twin</strong>
                    <div class="unity-progress-track"><div id="unity-progress-bar-full"></div></div>
                    <small>약 90MB의 기존 Unity 빌드를 불러옵니다.</small>
                </div>
                <div id="unity-warning"></div>
            </div>
        </article>

        <aside class="twin-sidecar">
            <article class="chart-card compact-chart">
                <div class="chart-heading"><div><span>BLAZOR OVERLAY</span><h2>Live sensor chart</h2></div><i class="sync-mark">SYNC</i></div>
                <MudChart ChartType="ChartType.Line" ChartSeries="@_series" XAxisLabels="@_labels" Width="100%" Height="240px" />
                <div class="mini-kpis"><span>Temp <b>@Value("temperature")°</b></span><span>Humidity <b>@Value("humidity")%</b></span><span>Soil <b>@Value("soil")%</b></span></div>
            </article>

            <article class="panel-card twin-control-card">
                <div class="panel-heading"><span>↔</span><div><h2>Bridge control</h2><p>Blazor → MQTT → Unity</p></div></div>
                <div class="quick-actions">
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => SendCommandAsync("farm/led/command", "TOGGLE"))">LED</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" OnClick="@(() => SendCommandAsync("farm/water/command", "TOGGLE"))">Water</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@(() => SendCommandAsync("farm/air/command", "TOGGLE"))">Air</MudButton>
                </div>
                <div class="bridge-log"><span>LAST BRIDGE EVENT</span><code>@(_lastMessage?.Topic ?? "waiting for telemetry")</code><p>@(_lastMessage?.Payload ?? "Unity와 Blazor가 연결되면 이벤트가 여기에 표시됩니다.")</p></div>
            </article>

            @if (!string.IsNullOrWhiteSpace(_activePanel))
            {
                <article class="unity-callout"><span>UNITY ACTION</span><strong>@_activePanel 패널 요청</strong><button @onclick="@(() => _activePanel = null)">닫기</button></article>
            }
        </aside>
    </section>

    @if (!string.IsNullOrWhiteSpace(_feedback))
    {
        <div class="toast-inline @(_feedbackSuccess ? "success" : "error")">@_feedback</div>
    }
</main>

@code {
    private DotNetObjectReference<VirtualFarm>? _reference;
    private TelemetryEnvelope? _lastMessage;
    private readonly Dictionary<string, double> _metrics = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<double> _temperature = [];
    private List<ChartSeries> _series = [];
    private string[] _labels = [];
    private bool _unityReady;
    private string? _activePanel;
    private string? _feedback;
    private bool _feedbackSuccess;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _reference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("unityBridge.initialize", _reference);
        try
        {
            _unityReady = await JS.InvokeAsync<bool>("unityBridge.load", new
            {
                containerSelector = "#unity-container",
                canvasSelector = "#unity-canvas",
                loadingBarSelector = "#unity-loading-bar",
                progressSelector = "#unity-progress-bar-full",
                warningSelector = "#unity-warning",
                loaderUrl = "Build/wwwroot.loader.js",
                dataUrl = "Build/wwwroot.data",
                frameworkUrl = "Build/wwwroot.framework.js",
                codeUrl = "Build/wwwroot.wasm",
                streamingAssetsUrl = "StreamingAssets"
            });
            await JS.InvokeVoidAsync("unityBridge.connectTelemetry", Navigation.ToAbsoluteUri("api/iot/events").ToString());
        }
        catch (JSException exception)
        {
            _feedback = $"Unity 로드 실패: {exception.Message}";
            _feedbackSuccess = false;
        }
        StateHasChanged();
    }

    [JSInvokable]
    public Task ReceiveTelemetry(string json)
    {
        var message = JsonSerializer.Deserialize<TelemetryEnvelope>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        if (message is null) return Task.CompletedTask;
        _lastMessage = message;
        foreach (var pair in message.Values)
        {
            var key = Normalize(pair.Key);
            _metrics[key] = pair.Value;
            if (key == "temperature")
            {
                _temperature.Add(pair.Value);
                if (_temperature.Count > 16) _temperature.RemoveAt(0);
            }
        }
        _labels = Enumerable.Range(1, _temperature.Count).Select(index => index.ToString()).ToArray();
        _series = [new ChartSeries { Name = "Temperature", Data = _temperature.ToArray() }];
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task ReceiveUnityMessage(string topic, string payload)
    {
        var result = await Api.PublishFromUnityAsync(new MqttPublishRequest { Topic = topic, Payload = payload, Source = "unity" });
        _feedback = result.Message;
        _feedbackSuccess = result.Success;
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task ShowBlazorPanel(string panelName)
    {
        _activePanel = panelName;
        return InvokeAsync(StateHasChanged);
    }

    private async Task SendCommandAsync(string topic, string payload)
    {
        var result = await Api.PublishAsync(new MqttPublishRequest { Topic = topic, Payload = payload, Qos = 1 });
        _feedback = result.Message;
        _feedbackSuccess = result.Success;
    }

    private async Task SetFullscreenAsync() => await JS.InvokeVoidAsync("unityBridge.setFullscreen");

    private string Value(string key) => _metrics.TryGetValue(key, out var value) ? value.ToString("0.0") : "--";
    private static string Normalize(string value) => value.ToLowerInvariant() switch
    {
        var key when key.Contains("temp") => "temperature",
        var key when key.Contains("humid") => "humidity",
        var key when key.Contains("soil") || key.Contains("moisture") => "soil",
        var key => key
    };

    public async ValueTask DisposeAsync()
    {
        if (_reference is null) return;
        try { await JS.InvokeVoidAsync("unityBridge.dispose"); } catch (JSDisconnectedException) { }
        _reference?.Dispose();
    }
}
