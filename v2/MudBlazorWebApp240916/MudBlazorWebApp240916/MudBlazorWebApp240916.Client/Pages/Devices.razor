@page "/Devices"
@using MudBlazorWebApp240916.Client.Services
@using MudBlazorWebApp240916.Shared.DataModel
@inject IoTApiClient Api

<PageTitle>Smart Grow · Device modules</PageTitle>

<main class="page-shell">
    <header class="page-heading">
        <div><span class="eyebrow">EDGE REGISTRY</span><h1>Device modules</h1><p>고정 IP 스캔 대신 장비별 MQTT 프로필을 등록해 네트워크 환경이 바뀌어도 재사용합니다.</p></div>
        <div class="status-pill online"><i></i>@_modules.Count registered</div>
    </header>

    <section class="module-layout">
        <article class="panel-card module-form-card">
            <div class="panel-heading"><span>+</span><div><h2>새 모듈</h2><p>Arduino, Raspberry Pi, ESP 계열</p></div></div>
            <div class="field-grid">
                <MudTextField T="string" Label="표시 이름" Variant="Variant.Outlined" Immediate="true" @bind-Value="_draft.Name" />
                <MudSelect T="string" Label="종류" Variant="Variant.Outlined" @bind-Value="_draft.Kind">
                    <MudSelectItem T="string" Value="@("Arduino")">Arduino</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Raspberry Pi")">Raspberry Pi</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ESP32")">ESP32</MudSelectItem>
                    <MudSelectItem T="string" Value="@("Custom")">Custom</MudSelectItem>
                </MudSelect>
                <MudTextField T="string" Label="장비 주소 (선택)" Placeholder="192.168.0.42" Variant="Variant.Outlined" Immediate="true" @bind-Value="_draft.Address" />
                <MudTextField T="string" Label="MQTT host" Variant="Variant.Outlined" Immediate="true" @bind-Value="_draft.MqttHost" />
                <MudNumericField T="int" Label="MQTT port" Min="1" Max="65535" Variant="Variant.Outlined" @bind-Value="_draft.MqttPort" />
                <MudTextField T="string" Label="Telemetry topic" Variant="Variant.Outlined" Immediate="true" @bind-Value="_draft.TelemetryTopic" />
                <MudTextField T="string" Label="Command topic" Variant="Variant.Outlined" Immediate="true" @bind-Value="_draft.CommandTopic" />
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="_busy" OnClick="AddModuleAsync">모듈 추가</MudButton>
        </article>

        <section class="module-list">
            <div class="section-heading compact"><div><span class="eyebrow">REGISTERED</span><h2>연결 프로필</h2></div><MudIconButton Icon="@Icons.Material.Filled.Refresh" OnClick="LoadModulesAsync" /></div>
            @if (_loading)
            {
                <div class="empty-state"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /><span>모듈을 불러오는 중입니다.</span></div>
            }
            else if (_modules.Count == 0)
            {
                <div class="empty-state"><b>＋</b><span>등록된 모듈이 없습니다.</span><small>왼쪽 양식에서 첫 장비를 추가하세요.</small></div>
            }
            else
            {
                @foreach (var module in _modules)
                {
                    <article class="device-card">
                        <div class="device-kind">@KindCode(module.Kind)</div>
                        <div class="device-copy"><span>@module.Kind</span><h3>@module.Name</h3><p>@(string.IsNullOrWhiteSpace(module.Address) ? "주소 미지정" : module.Address) · @module.MqttHost:@module.MqttPort</p><code>@module.TelemetryTopic</code></div>
                        <div class="device-actions">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Power" OnClick="@(() => ConnectModuleAsync(module))">연결</MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteModuleAsync(module.Id))" />
                        </div>
                    </article>
                }
            }
        </section>
    </section>

    @if (!string.IsNullOrWhiteSpace(_feedback))
    {
        <div class="toast-inline @(_feedbackSuccess ? "success" : "error")">@_feedback</div>
    }
</main>

@code {
    private List<DeviceModule> _modules = [];
    private DeviceModule _draft = NewDraft();
    private bool _loading = true;
    private bool _busy;
    private string? _feedback;
    private bool _feedbackSuccess;

    protected override async Task OnInitializedAsync() => await LoadModulesAsync();

    private async Task LoadModulesAsync()
    {
        _loading = true;
        try { _modules = await Api.GetModulesAsync(); }
        catch (HttpRequestException exception) { SetFeedback(false, exception.Message); }
        _loading = false;
    }

    private async Task AddModuleAsync()
    {
        _busy = true;
        var response = await Api.AddModuleAsync(_draft);
        SetFeedback(response.Result.Success, response.Result.Message);
        if (response.Module is not null)
        {
            _modules.Add(response.Module);
            _draft = NewDraft();
        }
        _busy = false;
    }

    private async Task ConnectModuleAsync(DeviceModule module)
    {
        _busy = true;
        var result = await Api.ConnectAsync(new MqttConnectionRequest
        {
            Host = module.MqttHost,
            Port = module.MqttPort,
            Topics = [module.TelemetryTopic]
        });
        SetFeedback(result.Success, result.Message);
        _busy = false;
    }

    private async Task DeleteModuleAsync(Guid id)
    {
        try
        {
            await Api.DeleteModuleAsync(id);
            _modules.RemoveAll(module => module.Id == id);
            SetFeedback(true, "모듈을 삭제했습니다.");
        }
        catch (HttpRequestException exception) { SetFeedback(false, exception.Message); }
    }

    private static DeviceModule NewDraft() => new()
    {
        Kind = "Arduino", MqttHost = "localhost", MqttPort = 1883,
        TelemetryTopic = "farm/device/telemetry", CommandTopic = "farm/device/command"
    };

    private static string KindCode(string kind) => kind switch
    {
        "Raspberry Pi" => "PI", "ESP32" => "E32", "Arduino" => "ARD", _ => "I/O"
    };

    private void SetFeedback(bool success, string message) { _feedbackSuccess = success; _feedback = message; }
}
