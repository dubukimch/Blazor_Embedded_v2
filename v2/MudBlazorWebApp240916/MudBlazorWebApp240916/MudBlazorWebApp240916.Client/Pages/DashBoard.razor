@page "/Dashboard"
@implements IAsyncDisposable
@using System.Text.Json
@using Microsoft.JSInterop
@using MudBlazor.Components.Chart.Models
@using MudBlazorWebApp240916.Client.Services
@using MudBlazorWebApp240916.Shared.DataModel
@inject IoTApiClient Api
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Smart Grow · Live telemetry</PageTitle>

<main class="page-shell telemetry-page">
    <header class="page-heading">
        <div><span class="eyebrow">LIVE OPERATIONS</span><h1>Telemetry console</h1><p>MQTT 수신값을 정규화해 Blazor와 Unity에 같은 이벤트로 전달합니다.</p></div>
        <div class="status-pill @(_status.IsConnected ? "online" : "offline")"><i></i>@(_status.IsConnected ? $"{_status.Host}:{_status.Port}" : "Broker offline")</div>
    </header>

    <section class="telemetry-layout">
        <aside class="control-stack">
            <article class="panel-card">
                <div class="panel-heading"><span>01</span><div><h2>MQTT broker</h2><p>서버 게이트웨이 연결</p></div></div>
                <div class="field-stack">
                    <MudTextField T="string" Label="Broker host" Variant="Variant.Outlined" Immediate="true" @bind-Value="_host" />
                    <MudNumericField T="int" Label="Port" Variant="Variant.Outlined" @bind-Value="_port" Min="1" Max="65535" />
                    <MudTextField T="string" Label="Subscribe topics" HelperText="쉼표로 여러 토픽 입력" Variant="Variant.Outlined" Immediate="true" @bind-Value="_topics" />
                </div>
                <div class="button-row">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Power" Disabled="_busy" OnClick="ConnectAsync">연결</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Filled.PowerOff" Disabled="_busy || !_status.IsConnected" OnClick="DisconnectAsync">해제</MudButton>
                </div>
            </article>

            <article class="panel-card">
                <div class="panel-heading"><span>02</span><div><h2>Command</h2><p>Arduino / Pi로 발행</p></div></div>
                <div class="field-stack">
                    <MudTextField T="string" Label="Publish topic" Variant="Variant.Outlined" Immediate="true" @bind-Value="_publishTopic" />
                    <MudTextField T="string" Label="Payload" Variant="Variant.Outlined" Lines="3" Immediate="true" @bind-Value="_publishPayload" />
                </div>
                <div class="button-row">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Send" Disabled="_busy || !_status.IsConnected" OnClick="PublishAsync">발행</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit" OnClick="SendSampleAsync">샘플 데이터</MudButton>
                </div>
            </article>
        </aside>

        <section class="dashboard-stage">
            <div class="kpi-grid">
                <article><span>TEMPERATURE</span><strong>@Metric("temperature", "--")<small> °C</small></strong><i class="trend mint">LIVE</i></article>
                <article><span>HUMIDITY</span><strong>@Metric("humidity", "--")<small> %</small></strong><i class="trend violet">LIVE</i></article>
                <article><span>SOIL MOISTURE</span><strong>@Metric("soil", "--")<small> %</small></strong><i class="trend amber">LIVE</i></article>
                <article><span>MESSAGES</span><strong>@_status.ReceivedMessages<small> total</small></strong><i class="trend neutral">MQTT</i></article>
            </div>

            <article class="chart-card">
                <div class="chart-heading"><div><span>REALTIME STREAM</span><h2>Environmental telemetry</h2></div><div class="stream-state"><i></i>@_streamState</div></div>
                <MudChart ChartType="ChartType.Line" ChartSeries="@_chartSeries" XAxisLabels="@_labels" Width="100%" Height="360px" />
            </article>

            <article class="event-card">
                <div class="chart-heading"><div><span>EVENT INSPECTOR</span><h2>Latest payload</h2></div><small>@(_lastMessage?.ReceivedAt.ToLocalTime().ToString("HH:mm:ss") ?? "waiting")</small></div>
                @if (_lastMessage is null)
                {
                    <div class="empty-state"><b>⌁</b><span>MQTT 메시지를 기다리는 중입니다.</span><small>브로커 없이도 ‘샘플 데이터’로 전체 흐름을 확인할 수 있습니다.</small></div>
                }
                else
                {
                    <div class="event-line"><span>@_lastMessage.Source</span><code>@_lastMessage.Topic</code><pre>@_lastMessage.Payload</pre></div>
                }
            </article>
        </section>
    </section>

    @if (!string.IsNullOrWhiteSpace(_feedback))
    {
        <div class="toast-inline @(_feedbackSuccess ? "success" : "error")">@_feedback</div>
    }
</main>

@code {
    private const string StreamKey = "dashboard";
    private DotNetObjectReference<DashBoard>? _reference;
    private MqttGatewayStatus _status = new();
    private TelemetryEnvelope? _lastMessage;
    private readonly Dictionary<string, double> _metrics = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<double> _temperature = [];
    private readonly List<double> _humidity = [];
    private readonly List<double> _soil = [];
    private List<ChartSeries> _chartSeries = [];
    private string[] _labels = [];
    private string _host = "localhost";
    private int _port = 1883;
    private string _topics = "farm/+/telemetry, sensors/#";
    private string _publishTopic = "farm/device/command";
    private string _publishPayload = "{\"action\":\"led\",\"value\":true}";
    private string _streamState = "connecting";
    private string? _feedback;
    private bool _feedbackSuccess;
    private bool _busy;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _reference = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("iotRealtime.connect", StreamKey,
            Navigation.ToAbsoluteUri("api/iot/events").ToString(), _reference, nameof(ReceiveTelemetry));
        await RefreshStatusAsync();
        BuildChart();
        StateHasChanged();
    }

    private async Task ConnectAsync()
    {
        _busy = true;
        var result = await Api.ConnectAsync(new MqttConnectionRequest
        {
            Host = _host,
            Port = _port,
            Topics = _topics.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList()
        });
        SetFeedback(result);
        await RefreshStatusAsync();
        _busy = false;
    }

    private async Task DisconnectAsync()
    {
        _busy = true;
        var result = await Api.DisconnectAsync();
        SetFeedback(result);
        await RefreshStatusAsync();
        _busy = false;
    }

    private async Task PublishAsync()
    {
        _busy = true;
        SetFeedback(await Api.PublishAsync(new MqttPublishRequest { Topic = _publishTopic, Payload = _publishPayload, Qos = 1 }));
        _busy = false;
    }

    private async Task SendSampleAsync()
    {
        var tick = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var payload = JsonSerializer.Serialize(new
        {
            temperature = 21 + tick % 8,
            humidity = 52 + tick % 13,
            soil = 61 + tick % 9
        });
        SetFeedback(await Api.PublishFromUnityAsync(new MqttPublishRequest
        {
            Topic = "demo/greenhouse/telemetry", Payload = payload, Source = "simulator"
        }));
    }

    [JSInvokable]
    public async Task ReceiveTelemetry(string json)
    {
        var message = JsonSerializer.Deserialize<TelemetryEnvelope>(json, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        if (message is null) return;
        _lastMessage = message;
        foreach (var pair in message.Values) _metrics[NormalizeMetric(pair.Key)] = pair.Value;
        Append(_temperature, FindValue(message, "temperature", "temp"));
        Append(_humidity, FindValue(message, "humidity", "humid"));
        Append(_soil, FindValue(message, "soil", "moisture"));
        BuildChart();
        await RefreshStatusAsync();
        await InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnStreamStateChanged(string state)
    {
        _streamState = state;
        return InvokeAsync(StateHasChanged);
    }

    private async Task RefreshStatusAsync()
    {
        try { _status = await Api.GetStatusAsync(); }
        catch (HttpRequestException exception) { _feedback = exception.Message; _feedbackSuccess = false; }
    }

    private void BuildChart()
    {
        var count = new[] { _temperature.Count, _humidity.Count, _soil.Count }.Max();
        _labels = Enumerable.Range(1, count).Select(index => index.ToString()).ToArray();
        _chartSeries =
        [
            new ChartSeries { Name = "Temperature", Data = Pad(_temperature, count) },
            new ChartSeries { Name = "Humidity", Data = Pad(_humidity, count) },
            new ChartSeries { Name = "Soil", Data = Pad(_soil, count) }
        ];
    }

    private static double[] Pad(List<double> values, int count) =>
        Enumerable.Repeat(double.NaN, Math.Max(0, count - values.Count)).Concat(values).ToArray();

    private static void Append(List<double> values, double? value)
    {
        if (!value.HasValue) return;
        values.Add(value.Value);
        if (values.Count > 24) values.RemoveAt(0);
    }

    private static double? FindValue(TelemetryEnvelope message, params string[] names)
    {
        foreach (var pair in message.Values)
            if (names.Any(name => NormalizeMetric(pair.Key).Contains(name, StringComparison.OrdinalIgnoreCase))) return pair.Value;
        return null;
    }

    private string Metric(string name, string fallback) =>
        _metrics.TryGetValue(name, out var value) ? value.ToString("0.0") : fallback;

    private static string NormalizeMetric(string value) => value.Replace("_", "").Replace("-", "").ToLowerInvariant() switch
    {
        var key when key.Contains("temperature") || key == "temp" => "temperature",
        var key when key.Contains("humidity") || key == "humid" => "humidity",
        var key when key.Contains("soil") || key.Contains("moisture") => "soil",
        var key => key
    };

    private void SetFeedback(ApiResult result) { _feedback = result.Message; _feedbackSuccess = result.Success; }

    public async ValueTask DisposeAsync()
    {
        if (_reference is null) return;
        try { await JS.InvokeVoidAsync("iotRealtime.disconnect", StreamKey); } catch (JSDisconnectedException) { }
        _reference?.Dispose();
    }
}
