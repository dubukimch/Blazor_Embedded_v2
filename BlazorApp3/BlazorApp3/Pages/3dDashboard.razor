@page "/3dDashboard"
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<PageTitle>3D Dashboard</PageTitle>

<h3>3D Dashboard</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}

<div id="@UnityContainerId" style="width: 960px; height: 600px;"></div>

@code {
    private const string UnityContainerId = "unityContainer";
    private IJSObjectReference? unityModule;
    private string errorMessage = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            unityModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/unityDashboard.js");
            await unityModule.InvokeVoidAsync("loadUnityDashboard", UnityContainerId);
        }
        catch (Exception ex)
        {
            errorMessage = $"Unity 대시보드 로딩 실패: {ex.Message}";
            StateHasChanged();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (unityModule == null)
        {
            return;
        }

        try
        {
            await unityModule.InvokeVoidAsync("disposeUnityDashboard");
            await unityModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }
}
