@page "/ledControl"
@implements IDisposable
@inject MqttService MqttService
@inject NavigationManager NavigationManager

<PageTitle>LED Control</PageTitle>

<h3>LED Control</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p class="text-muted">@statusMessage</p>
}

<button class="btn btn-success me-2" disabled="@(!isReady)" @onclick="TurnOn">Turn On</button>
<button class="btn btn-secondary" disabled="@(!isReady)" @onclick="TurnOff">Turn Off</button>

@code {
    private string mqttAddress = string.Empty;
    private int mqttPort;
    private string mqttTopic = string.Empty;
    private string statusMessage = string.Empty;
    private string errorMessage = string.Empty;
    private bool isReady;

    protected override async Task OnInitializedAsync()
    {
        MqttService.OnMessageReceived += HandleMqttMessage;

        if (!TryReadMqttQuery())
        {
            return;
        }

        isReady = await MqttService.ConnectAsync(mqttAddress, mqttPort, mqttTopic);
        statusMessage = MqttService.LastStatus;

        if (!isReady)
        {
            errorMessage = MqttService.LastError;
        }
    }

    private bool TryReadMqttQuery()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        mqttAddress = query["mqttAddress"] ?? string.Empty;
        mqttTopic = query["mqttTopic"] ?? string.Empty;

        if (string.IsNullOrWhiteSpace(mqttAddress))
        {
            errorMessage = "MQTT 서버 주소가 없습니다.";
            return false;
        }

        if (!int.TryParse(query["mqttPort"], out mqttPort) || mqttPort is < 1 or > 65535)
        {
            errorMessage = "MQTT 포트가 올바르지 않습니다.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(mqttTopic))
        {
            errorMessage = "MQTT 토픽이 없습니다.";
            return false;
        }

        return true;
    }

    private Task TurnOn()
    {
        return PublishLedCommand("ON");
    }

    private Task TurnOff()
    {
        return PublishLedCommand("OFF");
    }

    private async Task PublishLedCommand(string command)
    {
        var published = await MqttService.PublishMessageAsync(mqttTopic, command);
        statusMessage = MqttService.LastStatus;

        if (!published)
        {
            errorMessage = MqttService.LastError;
        }
    }

    private void HandleMqttMessage(string topic, string message)
    {
        statusMessage = $"Received message on {topic}: {message}";
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        MqttService.OnMessageReceived -= HandleMqttMessage;
    }
}
