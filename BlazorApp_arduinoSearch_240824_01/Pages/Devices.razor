@page "/devices"
@implements IDisposable
@inject DeviceDiscoveryService DeviceDiscoveryService
@inject IHttpClientFactory HttpClientFactory
@inject MqttService MqttService
@inject IJSRuntime JSRuntime
@using System.Text
@using System.Text.Json

<PageTitle>Devices</PageTitle>

<h3>연결 가능한 장비 목록</h3>

@if (!string.IsNullOrWhiteSpace(mqttStatus))
{
    <p class="text-muted">@mqttStatus</p>
}

@if (isLoading)
{
    <div class="mb-3">
        <p>장비를 검색 중입니다... @discoveryProgress.Message</p>
        <progress class="w-100" max="@ProgressMax" value="@discoveryProgress.Scanned"></progress>
        @if (!string.IsNullOrWhiteSpace(discoveryProgress.CurrentIpAddress))
        {
            <p class="small text-muted">최근 검색 IP: @discoveryProgress.CurrentIpAddress / 발견: @discoveryProgress.Found</p>
        }
    </div>
}
else if (devices.Any())
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>이름</th>
                <th>IP 주소</th>
                <th>설명</th>
                <th>MQTT 서버</th>
                <th>MQTT 포트</th>
                <th>MQTT 토픽</th>
                <th>연결</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var device in devices)
            {
                var deviceKey = GetDeviceKey(device);
                <tr>
                    <td>@DisplayValue(device.Name, "알 수 없음")</td>
                    <td>@device.Address</td>
                    <td>@DisplayValue(device.Description, "-")</td>
                    <td>
                        @if (!device.HasError)
                        {
                            <input class="form-control form-control-sm" type="text" placeholder="MQTT 서버" @bind="@device.MqttServer" />
                        }
                    </td>
                    <td>
                        @if (!device.HasError)
                        {
                            <input class="form-control form-control-sm" type="text" placeholder="MQTT 포트" @bind="@device.MqttPort" />
                        }
                    </td>
                    <td>
                        @if (!device.HasError)
                        {
                            <input class="form-control form-control-sm" type="text" placeholder="MQTT 토픽" @bind="@device.MqttTopic" />
                        }
                    </td>
                    <td>
                        @if (!device.HasError)
                        {
                            <button class="btn btn-primary btn-sm" @onclick="() => ConnectToDevice(device)">연결</button>
                            @if (connectionErrors.TryGetValue(deviceKey, out var error))
                            {
                                <div class="text-danger small mt-1">@error</div>
                            }
                        }
                        else
                        {
                            <button class="btn btn-danger btn-sm" disabled>오류 발생</button>

                        }
                    </td>
                    <td>
                        <input type="text" placeholder="MQTT 서버" @bind="@device.MqttServer" />
                    </td>
                    <td>
                        <input type="text" placeholder="MQTT 포트" @bind="@device.MqttPort" />
                    </td>
                    <td>
                        @if (device.MqttTopics != null && device.MqttTopics.Any())
                        {
                            <MatTreeView TNode="TreeNodeModel"
                                         RootNode="@device.TopicTreeRootNode"
                                         GetChildNodesCallback="@((n) => n.Nodes)"
                                         @bind-SelectedNode="@device.SelectedTopicNode">
                                <NodeTemplate>
                                    @context.Name
                                </NodeTemplate>
                            </MatTreeView>
                        }
                        else
                        {
                            <p>아두이노로부터 토픽을 불러오는 중...</p>
                        }
                    </td>
                    <td>
                        <button class="btn btn-success" @onclick="() => ConnectToDevice(device)" disabled="@(!device.MqttTopics?.Any() ?? true)">연결</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>장비를 찾을 수 없습니다.</p>
}

@code {
    private readonly Dictionary<string, string> connectionErrors = new();
    private List<Device> devices = new();
    private DeviceDiscoveryProgress discoveryProgress = new();
    private bool isLoading = true;
    private string mqttStatus = string.Empty;
    private bool disposed;

    private int ProgressMax => Math.Max(1, discoveryProgress.Total);


    private void OpenModal ()
    {
        var progress = new Progress<DeviceDiscoveryProgress>(value =>
        {
            discoveryProgress = value;

            if (!disposed)
            {
                _ = InvokeAsync(StateHasChanged);
            }
        });

        devices = await DeviceDiscoveryService.DiscoverDevicesAsync(progress);

        isLoading = false;

        foreach (var device in devices)
        {
            device.MqttServer = GetLocalIPAddress();
            device.MqttPort = "1883";

            device.TopicTreeRootNode = GenerateTreeNode(device.MqttTopics);
        }
    }

    private TreeNodeModel GenerateTreeNode (Dictionary<string, List<string>> mqttTopics)
    {
        var deviceKey = GetDeviceKey(device);
        connectionErrors.Remove(deviceKey);
        mqttStatus = string.Empty;

        if (!TryValidateMqtt(device, out var mqttPort))
        {
            return;
        }

        var connected = await MqttService.ConnectAsync(device.MqttServer, mqttPort, device.MqttTopic);
        mqttStatus = MqttService.LastStatus;

        if (!connected)
        {
            connectionErrors[deviceKey] = MqttService.LastError;
            return;
        }

        if (!await ConfigureMqttOnDevice(device, deviceKey))
        {
            return;
        }

        var url = device.Name switch
        {
            "Arduino LED Controller" => BuildDeviceUrl("/ledControl", device, mqttPort),
            "DHZ Sensor" => BuildDeviceUrl("/DHZChart", device, mqttPort),
            "Soil Moisture Sensor" => BuildDeviceUrl("/soilMoistureChart", device, mqttPort),
            _ => string.Empty
        };

        if (string.IsNullOrWhiteSpace(url))
        {
            connectionErrors[deviceKey] = $"지원하지 않는 장치 유형입니다: {DisplayValue(device.Name, "알 수 없음")}";
            return;
        }

        await JSRuntime.InvokeVoidAsync("openInNewTab", url);
    }

    private bool TryValidateMqtt(Device device, out int mqttPort)
    {
        mqttPort = 0;
        var deviceKey = GetDeviceKey(device);

        if (string.IsNullOrWhiteSpace(device.MqttServer))
        {
            connectionErrors[deviceKey] = "MQTT 서버를 입력하세요.";
            return false;
        }

        if (!int.TryParse(device.MqttPort, out mqttPort) || mqttPort is < 1 or > 65535)
        {
            connectionErrors[deviceKey] = "MQTT 포트는 1부터 65535 사이의 숫자여야 합니다.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(device.MqttTopic))
        {
            connectionErrors[deviceKey] = "MQTT 토픽을 입력하세요.";
            return false;
        }

        return true;
    }

    private async Task<bool> ConfigureMqttOnDevice(Device device, string deviceKey)
    {
        try
        {
            var httpClient = HttpClientFactory.CreateClient();
            var jsonData = new
            {
                mqtt_server = device.MqttServer,
                mqtt_port = device.MqttPort,
                mqtt_topic = device.MqttTopic
            };
            var jsonString = JsonSerializer.Serialize(jsonData);
            using var content = new StringContent(jsonString, Encoding.UTF8, "application/json");

            var response = await httpClient.PostAsync($"http://{device.Address}/configure_mqtt", content);

            if (response.IsSuccessStatusCode)
            {
                return true;
            }

            connectionErrors[deviceKey] = $"MQTT 설정 전송 실패: HTTP {(int)response.StatusCode}";
            return false;
        }
        catch (Exception ex)
        {
            connectionErrors[deviceKey] = $"MQTT 설정 전송 실패: {ex.Message}";
            return false;
        }
    }

    private static string BuildDeviceUrl(string path, Device device, int mqttPort)
    {
        return $"{path}?mqttAddress={Uri.EscapeDataString(device.MqttServer)}&mqttPort={mqttPort}&mqttTopic={Uri.EscapeDataString(device.MqttTopic)}";
    }

    private static string GetDeviceKey(Device device)
    {
        return string.IsNullOrWhiteSpace(device.Address) ? device.Name : device.Address;
    }

    private static string DisplayValue(string? value, string fallback)
    {
        return string.IsNullOrWhiteSpace(value) ? fallback : value;
    }

    public void Dispose()
    {
        disposed = true;

    }

    private string GetLocalIPAddress ()
    {
        var host = Dns.GetHostName();
        var ip = Dns.GetHostAddresses(host)
    .FirstOrDefault(i => i.AddressFamily == System.Net.Sockets.AddressFamily.InterNetwork);

        return ip?.ToString() ?? "localhost";
    }
}
