@page "/DHZChart"
@implements IAsyncDisposable
@using System.Text.Json
@using System.Text.Json.Serialization
@inject MqttService MqttService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>DHZ Chart</PageTitle>

<h3>DHZ Sensor</h3>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <p class="text-danger">@errorMessage</p>
}

@if (!string.IsNullOrWhiteSpace(statusMessage))
{
    <p class="text-muted">@statusMessage</p>
}

<canvas id="dhzTemperatureChart" width="400" height="200"></canvas>
<canvas id="dhzHumidityChart" width="400" height="200"></canvas>

@code {
    private readonly List<float> temperatureData = new();
    private readonly List<float> humidityData = new();
    private IJSObjectReference? chartModule;
    private string mqttAddress = string.Empty;
    private int mqttPort;
    private string mqttTopic = string.Empty;
    private string statusMessage = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        MqttService.OnMessageReceived += HandleMqttMessage;

        if (!TryReadMqttQuery())
        {
            return;
        }

        var connected = await MqttService.ConnectAsync(mqttAddress, mqttPort, mqttTopic);
        statusMessage = MqttService.LastStatus;

        if (!connected)
        {
            errorMessage = MqttService.LastError;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            chartModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/sensorChart.js");
            await chartModule.InvokeVoidAsync("initializeDhzCharts");
            await UpdateCharts();
        }
        catch (Exception ex)
        {
            errorMessage = $"차트 초기화 실패: {ex.Message}";
            StateHasChanged();
        }
    }

    private bool TryReadMqttQuery()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);

        mqttAddress = query["mqttAddress"] ?? string.Empty;
        mqttTopic = query["mqttTopic"] ?? string.Empty;

        if (string.IsNullOrWhiteSpace(mqttAddress))
        {
            errorMessage = "MQTT 서버 주소가 없습니다.";
            return false;
        }

        if (!int.TryParse(query["mqttPort"], out mqttPort) || mqttPort is < 1 or > 65535)
        {
            errorMessage = "MQTT 포트가 올바르지 않습니다.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(mqttTopic))
        {
            errorMessage = "MQTT 토픽이 없습니다.";
            return false;
        }

        return true;
    }

    private void HandleMqttMessage(string topic, string message)
    {
        _ = InvokeAsync(async () =>
        {
            try
            {
                var sensorData = JsonSerializer.Deserialize<DhzSensorData>(message);

                if (sensorData == null)
                {
                    return;
                }

                temperatureData.Add(sensorData.Temperature);
                humidityData.Add(sensorData.Humidity);
                TrimSeries();

                statusMessage = $"Received message on {topic}.";
                await UpdateCharts();
                StateHasChanged();
            }
            catch (JsonException ex)
            {
                errorMessage = $"센서 데이터 파싱 실패: {ex.Message}";
                StateHasChanged();
            }
        });
    }

    private async Task UpdateCharts()
    {
        if (chartModule == null)
        {
            return;
        }

        await chartModule.InvokeVoidAsync(
            "updateDhzCharts",
            temperatureData.ToArray(),
            humidityData.ToArray());
    }

    private void TrimSeries()
    {
        if (temperatureData.Count <= 10)
        {
            return;
        }

        temperatureData.RemoveAt(0);
        humidityData.RemoveAt(0);
    }

    public async ValueTask DisposeAsync()
    {
        MqttService.OnMessageReceived -= HandleMqttMessage;

        if (chartModule == null)
        {
            return;
        }

        try
        {
            await chartModule.InvokeVoidAsync("disposeDhzCharts");
            await chartModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

    public class DhzSensorData
    {
        [JsonPropertyName("temperature")]
        public float Temperature { get; set; }

        [JsonPropertyName("humidity")]
        public float Humidity { get; set; }
    }
}
