@page "/DHZChart"
@implements IAsyncDisposable
@inject MqttService MqttService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>DHZ Sensor</PageTitle>

<div class="container mt-4">
    <h3 class="mb-3">DHZ 센서 데이터</h3>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = string.Empty"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">온도 (Temperature)</div>
                <div class="card-body">
                    <canvas id="dhzTemperatureChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">습도 (Humidity)</div>
                <div class="card-body">
                    <canvas id="dhzHumidityChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private readonly List<float> temperatureData = new();
    private readonly List<float> humidityData = new();
    private IJSObjectReference? chartModule;
    private string mqttAddress = string.Empty;
    private int mqttPort;
    private string mqttTopic = string.Empty;
    private string statusMessage = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (!TryReadMqttQuery())
        {
            return;
        }

        var connected = await MqttService.ConnectAsync(mqttAddress, mqttPort, mqttTopic);
        statusMessage = MqttService.LastStatus;

        if (!connected)
        {
            errorMessage = MqttService.LastError;
            return;
        }

        MqttService.OnMessageReceived += HandleMqttMessage;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            chartModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./js/sensorChart.js");
            await chartModule.InvokeVoidAsync("initializeDhzCharts");
            await UpdateCharts();
        }
        catch (Exception ex)
        {
            errorMessage = $"차트 초기화 실패: {ex.Message}";
            StateHasChanged();
        }
    }

    private bool TryReadMqttQuery()
    {
        if (!MqttQueryStringParser.TryParse(NavigationManager.Uri, out var parameters, out errorMessage))
        {
            return false;
        }

        mqttAddress = parameters.Server;
        mqttPort = parameters.Port;
        mqttTopic = parameters.Topic;
        return true;
    }

    private void HandleMqttMessage(string topic, string message)
    {
        _ = InvokeAsync(async () =>
        {
            if (!SensorPayloadParser.TryParseDhz(message, out var sensorData, out var parseError))
            {
                errorMessage = $"센서 데이터 파싱 실패: {parseError}";
                StateHasChanged();
                return;
            }

            temperatureData.Add(sensorData.Temperature);
            humidityData.Add(sensorData.Humidity);
            TrimSeries();

            errorMessage = string.Empty;
            statusMessage = $"{topic}에서 메시지 수신 - 온도: {sensorData.Temperature}°C, 습도: {sensorData.Humidity}%";
            await UpdateCharts();
            StateHasChanged();
        });
    }

    private async Task UpdateCharts()
    {
        if (chartModule == null)
        {
            return;
        }

        await chartModule.InvokeVoidAsync(
            "updateDhzCharts",
            temperatureData.ToArray(),
            humidityData.ToArray());
    }

    private void TrimSeries()
    {
        if (temperatureData.Count <= 10)
        {
            return;
        }

        temperatureData.RemoveAt(0);
        humidityData.RemoveAt(0);
    }

    public async ValueTask DisposeAsync()
    {
        MqttService.OnMessageReceived -= HandleMqttMessage;

        if (chartModule == null)
        {
            return;
        }

        try
        {
            await chartModule.InvokeVoidAsync("disposeDhzCharts");
            await chartModule.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
        }
    }

}

<style>
    .card {
        border: 1px solid #dee2e6;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
        margin-bottom: 1.5rem;
    }

    .card-header {
        background-color: #f8f9fa;
        font-weight: 600;
        border-bottom: 1px solid #dee2e6;
    }

    .card-body {
        padding: 1.5rem;
    }

    canvas {
        max-width: 100%;
    }
</style>

